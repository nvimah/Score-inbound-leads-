      "parameters": {
        "jsCode": "const lead = $('Merge lead + AI verdict').first().json;\nconst crm = $input.first().json;\nreturn [{ json: {\n  ...lead,\n  contact_id: crm.vid ?? crm.id,\n  crm_status: crm.isNew === undefined ? 'unknown' : (crm.isNew ? 'created' : 'updated')\n} }];"
      },
