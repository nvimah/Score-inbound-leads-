    {
      "parameters": {
        "jsCode": "const lead = $('Normalise + dedupe (24h)').first().json;\nconst first = $input.first().json;\nconst raw = first.content?.parts?.[0]?.text ?? first.text ?? '';\nlet ai;\ntry {\n  ai = JSON.parse(String(raw).replace(/```json|```/g, '').trim());\n} catch (e) {\n  ai = { score: 0, verdict: 'cold', summary: 'AI parse failed', draft_reply: '' };\n}\nconst score = Number(ai.score ?? 0);\nreturn [{ json: { ...lead, ai, score, hot: score >= lead.cfg.hot_threshold, usage: first.usage } }];"
      },
      "name": "Merge lead + AI verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        192
      ],
      "id": "e427a5c3-1c0e-4de2-ba83-bb241bf7655d"
    },
