        1024
      ],
      "id": "fd565e26-9361-4dd3-a934-091c7b2beafd"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "=You qualify inbound leads for a local service business. Return ONLY valid JSON, with no markdown fences and no extra text, in exactly this shape:\n{\"score\": <0-100>, \"verdict\": \"hot\" | \"warm\" | \"cold\", \"summary\": \"<one sentence>\", \"draft_reply\": \"<2-3 friendly sentences replying to the lead, no pricing promises>\"}\n\nScore higher for: a clear need, urgency (\"this week\", \"ASAP\"), a stated budget, and a specific service. Score lower for: vague messages, no contact details, or spam.\n\nLead:\nName: {{ $json.name }}\nService: {{ $json.service }}\nMessage: {{ $json.message }}\nCompany: {{ $json.company }}\nBudget: {{ $json.budget }}"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
